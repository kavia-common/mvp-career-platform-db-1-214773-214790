# Example environment variables for CareerPlatformDatabase container
# This file is optional and used for local development. Do not commit secrets.
# At runtime, set variables via Docker/Compose environment blocks or secrets.

# PostgreSQL configuration used by startup.sh and db_visualizer
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_PORT=5000

# db_visualizer runtime variables (if using external DBs instead of the built-in)
# Postgres viewer
POSTGRES_URL=postgresql://localhost:5000/myapp

# MySQL viewer (optional - only if you connect to MySQL externally)
MYSQL_URL=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_PORT=

# SQLite viewer (optional)
SQLITE_DB=

# MongoDB viewer (optional)
MONGODB_URL=
MONGODB_DB=

# Node server port for db_visualizer
PORT=3000
