{"is_source_file": true, "format": "bash", "description": "A comprehensive shell script for automating backups of various databases (SQLite, PostgreSQL, MySQL, MongoDB). It detects the active database and performs backup accordingly, reading configuration from environment variables.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["pg_isready", "ls", "mysqladmin", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres ${PG_BIN}/pg_isready", "cp \"${DB_NAME}\" \"database_backup.db\"", "echo \"Backing up SQLite database...\"", "echo \"\u2713 Backup saved to database_backup.db\"", "ls /usr/lib/postgresql/", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD}", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD}", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD}", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD}", "mysql --socket=/var/run/mysqld/mysqld.sock -u root -e \"SELECT 1\"", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup", "PostgreSQL", "MySQL", "MongoDB", "SQLite", "database detection", "shell script backup"], "state": 2, "file_id": 5, "knowledge_revision": 24, "git_revision": "02e4a274e8f4bf93f745469d9a10a5d041a81a9b", "revision_history": [{"11": "f3c54f14e00d5a7e6ce