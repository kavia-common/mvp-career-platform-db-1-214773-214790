# This file documents runtime env variables for the CareerPlatformDatabase container.
# IMPORTANT: This file is NOT read at build time or startup. Provide variables via Docker/Compose/Kubernetes.

# PostgreSQL runtime configuration (required)
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
# Optional (defaults to 5000 in our startup script; postgres default is 5432 if you run native)
POSTGRES_PORT=5000

# db_visualizer optional port
PORT=3000

# Other supported databases (for viewer only; optional)
# MYSQL_URL=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=
# MYSQL_PORT=

# SQLITE_DB=
# MONGODB_URL=
# MONGODB_DB=
