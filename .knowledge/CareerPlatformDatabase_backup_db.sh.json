{"is_source_file": true, "format": "bash", "description": "This script automates database backups for various database systems (SQLite, PostgreSQL, MySQL, MongoDB). It detects which database is currently running and performs the appropriate backup procedure, reading configuration from environment variables or defaults.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo -u postgres pg_isready", "ls", "mongosh", "mongodump", "mysqladmin", "mysql", "mysqldump", "sudo mysql"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres ${PG_BIN}/pg_isready", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD} -e \"SELECT 1\"", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} -e \"SELECT 1\"", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup script", "detects and backs up databases", "PostgreSQL backup", "MySQL backup", "SQLite check", "MongoDB backup"], "state": 2, "file_id": 5, "knowledge_revision": 19, "git_revision": "e1adcbe551d246173381c56c6be1c4fe0202b978", "revision_history": [{"11": "f3c54f14e00d5a7e6ce