# Runtime environment variables for CareerPlatformDatabase container
# These are read at runtime by startup.sh and db_visualizer/server.js
# Do NOT copy this file into images. Provide values via docker run -e or docker-compose.

# PostgreSQL
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_PORT=5000

# Optional: MySQL (for db_visualizer only; PostgreSQL is the primary DB)
# MYSQL_URL=true
# MYSQL_DB=mysql
# MYSQL_USER=root
# MYSQL_PASSWORD=change-me
# MYSQL_PORT=3306

# Optional: SQLite (db_visualizer)
# SQLITE_DB=/app/sqlite.db

# Optional: MongoDB (db_visualizer)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=test

# db_visualizer HTTP port
PORT=3000
