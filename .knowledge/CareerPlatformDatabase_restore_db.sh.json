{"is_source_file": true, "format": "bash", "description": "A shell script for restoring various types of databases (SQLite, PostgreSQL, MySQL, MongoDB) by detecting backup files and performing corresponding restore commands based on environment variables and system conditions.", "external_files": ["database_backup.db", "database_backup.sql", "database_backup.archive"], "external_methods": ["ls", "sudo -u postgres pg_isready", "psql", "mysqladmin", "mysql", "mongosh", "mongorestore", "sudo mysql"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres pg_isready -p ${DB_PORT}", "psql -h localhost -p ${DB_PORT} -U ${DB_USER} -d postgres < database_backup.sql", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD} -e \"SELECT 1\"", "sudo mysql --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} -e \"SELECT 1\"", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongorestore --port ${DB_PORT} --archive=database_backup.archive --drop --quiet"], "search-terms": ["restore_db.sh", "database restore", "PostgreSQL restore", "MySQL restore", "MongoDB restore", "database backup detection", "bash database restore script"], "state": 2, "file_id": 1, "knowledge_revision": 25, "git_revision": "02e4a274e8f4bf93f745469d9a10a5d041a81a9b", "revision_history": [{"14": "f3c54f14e00d5a7e6ce75ea8a8d5b17b4f922296"}, {"20": "e1adcbe551d246173381c56c6be1c4fe0202b978"}, {"25": "02e4a274e8f4bf93f745469d9a10a5d041a81a9b"}], "hash": "54f59d63c00501024e73ecd54fbf3cff", "format-version": 4, "code-base-name": "CareerPlatformDatabase", "filename": "CareerPlatformDatabase/restore_db.sh"}